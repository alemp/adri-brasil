---
import Base from '../../layouts/Base.astro';
import { langs } from '../../lib/i18n.js';
import { owner as o } from '../../lib/legal.js';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const de = lang === 'de';
---
<Base lang={lang} title="Impressum | Adri Brasil">
  <section class="legal">
    <div class="wrap">
      <h1>Impressum</h1>
      <h2>{de ? 'Angaben gemäß § 5 DDG' : 'Information according to § 5 DDG (German Digital Services Act)'}</h2>
      <p>{o.name}<br />Adri Brasil<br />{o.street}<br />{o.city}<br />{o.country}</p>

      <h2>{de ? 'Kontakt' : 'Contact'}</h2>
      <p>{de ? 'E-Mail' : 'Email'}: <a href={`mailto:${o.email}`}>{o.email}</a></p>

      {o.vatId && <><h2>{de ? 'Umsatzsteuer-ID' : 'VAT ID'}</h2>
        <p>{de ? 'Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG' : 'VAT identification number according to § 27a UStG'}: {o.vatId}</p></>}

      <h2>{de ? 'Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV' : 'Responsible for content according to § 18 (2) MStV'}</h2>
      <p>{o.name}, {o.street}, {o.city}</p>

      <h2>{de ? 'Haftung für Links' : 'Liability for links'}</h2>
      <p>{de
        ? 'Diese Website enthält Links zu externen Websites Dritter (z. B. Instagram, Google Maps, Google Fotos). Auf deren Inhalte habe ich keinen Einfluss; für sie ist der jeweilige Anbieter verantwortlich. Bei Bekanntwerden von Rechtsverletzungen entferne ich solche Links umgehend.'
        : 'This website links to external third-party websites (e.g. Instagram, Google Maps, Google Photos). I have no influence on their content; the respective provider is responsible for it. If I become aware of any legal violations, I will remove such links immediately.'}</p>

      <h2>{de ? 'Urheberrecht' : 'Copyright'}</h2>
      <p>{de
        ? 'Texte, Fotos und Videos auf dieser Website unterliegen dem Urheberrecht. Eine Verwendung außerhalb der Grenzen des Urheberrechts bedarf der vorherigen Zustimmung.'
        : 'Texts, photos and videos on this website are protected by copyright. Any use beyond the limits of copyright law requires prior consent.'}</p>
      {!de && <p class="note">The German version of this page is legally binding: <a href="/de/impressum/">Impressum (Deutsch)</a>.</p>}
    </div>
  </section>
</Base>
