---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { langs, ui } from '../../lib/i18n.js';
import { upcomingEvents, settings, artists, curriculum, img, t, rich } from '../../lib/sanity.js';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const u = ui[lang];
const [events, s, crew, levels] = await Promise.all([upcomingEvents(), settings(), artists(), curriculum()]);
// One chip per artist; newest year first (query order), link to photos when there are any.
const names = [...new Map(crew.map((a) => [a.name.replace(/ \(.*\)$/, ''), a.videoUrl])).entries()];
// Service cards: photo from Site settings, gradient until one is uploaded.
const doors = [
  { k: 'learn', href: '#workshops', grad: 'var(--pink),#8A2F7B' },
  { k: 'dj', href: '#dj', grad: 'var(--leaf),#0E5C56' },
  { k: 'bands', href: '#artists', grad: 'var(--sun),#C2581B' },
];
const flags =['#FFC93C', '#FF5C8A', '#2FBF71', '#FFF4DC'];
const bunting = Array.from({ length: 16 }, (_, i) => {
  const x = 40 + i * 72, y = 6 + 38 * Math.sin(Math.PI * (x / 1200)) * 0.98;
  return { points: `${x - 26},${y} ${x + 26},${y} ${x},${y + 44}`, fill: flags[i % 4] };
});
---
<Base lang={lang}>
  <section class="hero" aria-label="Intro">
    <div class="bg" aria-hidden="true" style={s?.heroImage && `--herobg:url(${img(s.heroImage, 1800)})`}></div>
    <svg id="bunting" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 6 Q600 44 1200 6" fill="none" stroke="#FFF4DC" stroke-width="2" />
      {bunting.map((f) => <polygon points={f.points} fill={f.fill} />)}
    </svg>
    <div class="wrap">
      <h1>{t(s?.heroTitle, lang)}<span>{t(s?.heroSubtitle, lang)}</span></h1>
      <p>{t(s?.tagline, lang)}</p>
      <div class="cta"><a class="btn" href="#events">{u.seeEvents}</a><a class="btn alt" href="#contact">{u.bookMe}</a></div>
    </div>
  </section>

  <section class="events" id="events">
    <div class="wrap">
      <h2>{u.next}</h2>
      <div class="evgrid">
        {events.slice(0, 2).map((e) => <EventCard event={e} lang={lang} />)}
        <article class="ev">
          {s?.onDemandImage && <img src={img(s.onDemandImage, 600)} alt="" loading="lazy" />}
          <div class="date">{u.odDate}<small>{u.odSmall}</small></div>
          <h3>{u.odTitle}</h3>
          <p>{u.odText}</p>
          <details><summary>{u.more}</summary><p>{u.odDet}</p><a href="#contact">{u.book}</a></details>
        </article>
      </div>
      <p class="all"><a href={`/${lang}/events/`}>{u.allEvents}</a></p>
    </div>
  </section>

  <section id="doors">
    <div class="wrap">
      <h2>{u.doors}</h2>
      <div class="doors">
        {doors.map((d) => (
          <a class="door" href={d.href}>
            <div class="ph" style={`background:${s?.[`${d.k}Image`] ? `url(${img(s[`${d.k}Image`], 800)}) center/cover, ` : ''}linear-gradient(160deg,${d.grad})`}></div>
            <h3>{t(s?.[`${d.k}Title`], lang)}</h3><div class="rt" set:html={rich(t(s?.[`${d.k}Text`], lang))} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tint" id="workshops">
    <div class="wrap">
      <h2>{u.workshops}</h2>
      {['beginner', 'intermediate', 'advanced'].map((g) => (
        <details class="level">
          <summary>{u[g]}</summary>
          <ul>{levels.filter((l) => l.group === g).map((l) => <li><strong>{t(l.title, lang)}</strong><div class="rt" set:html={rich(t(l.description, lang))} /></li>)}</ul>
        </details>
      ))}
    </div>
  </section>

  <section id="dj">
    <div class="wrap">
      <h2>{u.djH}</h2>
      <p class="lead">{u.djIntro}</p>
      <ul class="gear">{s?.equipment?.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="tint" id="about">
    <div class="wrap split">
      <div>
        <h2>{u.aboutH}</h2>
        <div class="rt" set:html={rich(t(s?.aboutShort, lang))} />
        {t(s?.about, lang) && <details class="story"><summary class="btn alt">{u.story}</summary><div class="rt" set:html={rich(t(s.about, lang))} /></details>}
      </div>
      <div class="ph" style={`min-height:320px;background:${s?.aboutImage ? `url(${img(s.aboutImage, 900)}) center/cover, ` : ''}linear-gradient(200deg,#3A2A8C,#FF5C8A)`}></div>
    </div>
  </section>

  <section class="artists" id="artists">
    <div class="wrap">
      <h2>{u.artists}</h2>
      <div class="names">{names.map(([n, url]) => url ? <a href={url}>{n}</a> : <span>{n}</span>)}</div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <h2>{u.contact}</h2>
      {s?.contactImage && <img class="banner" src={img(s.contactImage, 2000)} alt="" loading="lazy" />}
      <p class="lead">{u.contactLead}</p>
      <div class="ways">
        {s?.email && <a class="way mail" href={`mailto:${s.email}`}>
          <div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></div>
          <div><b>{u.email}</b><span>{s.email}</span></div>
          <div class="go" aria-hidden="true">→</div>
        </a>}
        {s?.instagram && <a class="way insta" href={s.instagram}>
          <div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" /></svg></div>
          <div><b>Instagram</b><span>{u.dm} @{s.instagram.split('/').filter(Boolean).pop()}</span></div>
          <div class="go" aria-hidden="true">→</div>
        </a>}
        {s?.patreon && <a class="way patreon" href={s.patreon}>
          <div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="14.5" cy="9.5" r="5.5" /><path d="M4 4v16" /></svg></div>
          <div><b>Patreon</b><span>{u.support}</span></div>
          <div class="go" aria-hidden="true">→</div>
        </a>}
      </div>
      <div class="tips">
        <strong>{u.tips}</strong>
        <ul>{u.tipsList.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero { padding:0; position:relative; overflow:hidden; background:radial-gradient(120% 90% at 80% 10%,#3A2A8C 0%,var(--bg) 60%); }
  .hero .bg { position:absolute; inset:0; background:var(--herobg,repeating-linear-gradient(115deg,#5B2A9A 0 60px,#7A2E9C 60px 120px)); background-size:cover; background-position:center; }
  .hero .bg::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,rgba(20,25,90,.92) 0%,rgba(20,25,90,.6) 55%,rgba(20,25,90,.25) 100%); }
  #bunting, .hero .wrap { position:relative; z-index:1; }
  #bunting { display:block; width:100%; height:auto; transform-origin:50% 0; animation:sway 2.4s ease-out 1; }
  @keyframes sway { 0% { transform:rotate(-1.2deg); } 40% { transform:rotate(.7deg); } 100% { transform:rotate(0); } }
  .hero .wrap { padding-top:36px; padding-bottom:84px; }
  .hero h1 { font-size:clamp(4.4rem,17vw,12rem); letter-spacing:-.03em; color:var(--sun); }
  .hero h1 span { display:block; color:var(--ink); font-size:.34em; letter-spacing:-.01em; margin-top:10px; }
  .hero p { max-width:34ch; font-size:1.2rem; color:var(--mute); margin:20px 0 28px; }
  .cta { display:flex; gap:12px; flex-wrap:wrap; }

  .events h2 { color:var(--bg); }
  .evgrid { margin-bottom:0; }
  .all { margin-top:26px; }
  .all a { color:var(--bg); font-weight:600; }

  .doors { display:grid; gap:18px; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); }
  .door { text-decoration:none; display:flex; flex-direction:column; gap:12px; }
  .door .ph { min-height:230px; transition:transform .2s; }
  .door:hover .ph, .door:focus-visible .ph { transform:translateY(-4px); }
  .door h3 { font-size:1.7rem; }
  .door p, .lead, .tint p { margin:0; color:var(--mute); }

  .tint { background:var(--bg2); }
  .level { background:var(--bg); border-radius:14px; padding:14px 18px; margin-bottom:12px; }
  .level summary { cursor:pointer; font:800 1.4rem var(--disp); color:var(--sun); }
  .level li { margin:8px 0; color:var(--mute); } .level strong { color:var(--ink); }
  .gear { display:flex; flex-wrap:wrap; gap:10px; list-style:none; padding:0; margin:22px 0 0; }
  .gear li { background:var(--bg2); border-radius:999px; padding:8px 16px; font-weight:600; font-size:15px; }

  .split { display:grid; gap:34px; grid-template-columns:1fr 1fr; align-items:center; }
  .split p { max-width:52ch; margin-bottom:20px; }
  .story summary { list-style:none; } .story summary::-webkit-details-marker { display:none; }
  .story[open] summary { display:none; }
  .split .rt { max-width:52ch; color:var(--mute); margin-bottom:20px; }

  .artists { padding:44px 0; background:var(--sun); color:var(--bg); }
  .artists h2 { font-size:1.6rem; margin-bottom:16px; }
  .names { display:flex; flex-wrap:wrap; gap:10px; }
  .names > * { background:var(--bg); color:var(--ink); border-radius:999px; padding:8px 16px; font-weight:600; font-size:15px; text-decoration:none; }
  .names a:hover { background:var(--pink); }

  .contact .lead { max-width:52ch; margin:-14px 0 30px; }
  .banner { display:block; width:100%; height:auto; border-radius:18px; margin-bottom:34px; }
  .ways { display:grid; gap:18px; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); }
  .way { display:flex; gap:18px; align-items:center; text-decoration:none; background:var(--bg2); border-radius:18px; padding:22px 24px; transition:transform .15s, background .15s; }
  .way:hover { transform:translateY(-3px); background:#262e8f; }
  .icon { flex:none; width:58px; height:58px; border-radius:50%; display:grid; place-items:center; }
  .icon svg { width:28px; height:28px; fill:none; stroke:var(--bg); stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .mail .icon { background:var(--sun); } .insta .icon { background:var(--pink); } .patreon .icon { background:var(--leaf); }
  .way b { display:block; font:800 1.35rem/1.1 var(--disp); }
  .way span { display:block; color:var(--mute); font-size:15px; margin-top:4px; overflow-wrap:anywhere; }
  .way .go { margin-left:auto; font:800 1.6rem var(--disp); color:var(--sun); }
  .tips { margin-top:28px; color:var(--mute); font-size:15px; }
  .tips strong { color:var(--ink); }
  .tips ul { display:flex; flex-wrap:wrap; gap:8px; list-style:none; padding:0; margin:10px 0 0; }
  .tips li { border:2px solid #3b43a8; border-radius:999px; padding:5px 14px; }

  @media (max-width:760px) { .split { grid-template-columns:1fr; } }
  @media (prefers-reduced-motion:reduce) { #bunting { animation:none; } .door .ph, .way { transition:none; } }
</style>
