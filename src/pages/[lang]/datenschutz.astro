---
import Base from '../../layouts/Base.astro';
import { langs, ui } from '../../lib/i18n.js';
import { owner as o } from '../../lib/legal.js';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const de = lang === 'de';
// Each section: [German heading, German text, English heading, English text].
const sections = [
  ['Allgemeines', 'Ich nehme den Schutz deiner Daten ernst. Diese Website verwendet keine Cookies, kein Tracking und keine Analyse-Tools. Personenbezogene Daten werden nur verarbeitet, soweit es für den Betrieb der Website und die Bearbeitung von Anfragen nötig ist.',
   'General', 'I take the protection of your data seriously. This website uses no cookies, no tracking and no analytics tools. Personal data is processed only as far as needed to run the website and handle requests.'],
  ['Hosting', 'Diese Website wird bei Cloudflare gehostet (Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, USA). Beim Aufruf der Seiten verarbeitet Cloudflare technisch notwendige Daten wie IP-Adresse, Datum und Uhrzeit, aufgerufene Seite und Browser-Informationen, um die Website auszuliefern und vor Angriffen zu schützen. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an einem sicheren und stabilen Betrieb). Cloudflare ist unter dem EU-US Data Privacy Framework zertifiziert.',
   'Hosting', 'This website is hosted on Cloudflare (Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, USA). When you visit, Cloudflare processes technically necessary data such as IP address, date and time, requested page and browser information to deliver the website and protect it from attacks. Legal basis is Art. 6(1)(f) GDPR (legitimate interest in secure, stable operation). Cloudflare is certified under the EU-US Data Privacy Framework.'],
  ['Kontakt per E-Mail oder Instagram', 'Wenn du mir eine E-Mail oder eine Instagram-Nachricht schreibst, verarbeite ich die Daten, die du mir schickst (z. B. Name, E-Mail-Adresse, Nachricht), um deine Anfrage zu beantworten. E-Mails landen in meinem Postfach bei Google Gmail (Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Irland). Für Instagram-Nachrichten gelten zusätzlich die Datenschutzbestimmungen von Meta Platforms Ireland Limited. Rechtsgrundlage ist Art. 6 Abs. 1 lit. b DSGVO (Anbahnung eines Vertrags) bzw. lit. f (berechtigtes Interesse an der Beantwortung von Anfragen). Die Daten werden gelöscht, sobald sie nicht mehr benötigt werden und keine gesetzlichen Aufbewahrungspflichten bestehen.',
   'Contact by email or Instagram', 'When you send me an email or an Instagram message, I process the data you send (e.g. name, email address, message) to answer your request. Emails arrive in my Google Gmail inbox (Google Ireland Limited, Gordon House, Barrow Street, Dublin 4, Ireland). Instagram messages are also subject to the privacy policy of Meta Platforms Ireland Limited. Legal basis is Art. 6(1)(b) GDPR (steps prior to a contract) or (f) (legitimate interest in answering requests). The data is deleted once it is no longer needed and no legal retention obligations apply.'],
  ['Bilder und Inhalte (Sanity)', 'Texte und Bilder dieser Website werden über das Content-System Sanity (Sanity AS, Oslo, Norwegen) verwaltet. Bilder werden vom Server cdn.sanity.io geladen; dabei wird deine IP-Adresse an Sanity übertragen. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an einer schnellen Auslieferung der Inhalte).',
   'Images and content (Sanity)', 'Texts and images on this website are managed with the content system Sanity (Sanity AS, Oslo, Norway). Images load from the server cdn.sanity.io, which transmits your IP address to Sanity. Legal basis is Art. 6(1)(f) GDPR (legitimate interest in fast content delivery).'],
  ['Schriftarten (Google Fonts)', 'Diese Website nutzt Schriftarten von Google Fonts (Google Ireland Limited). Beim Laden der Seite wird deine IP-Adresse an Google übertragen. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an einer einheitlichen Darstellung).',
   'Fonts (Google Fonts)', 'This website uses fonts from Google Fonts (Google Ireland Limited). When the page loads, your IP address is sent to Google. Legal basis is Art. 6(1)(f) GDPR (legitimate interest in consistent presentation).'],
  ['Externe Links', 'Links zu Instagram, Google Maps und Google Fotos sind einfache Links. Daten werden erst übertragen, wenn du sie anklickst; dann gelten die Datenschutzbestimmungen des jeweiligen Anbieters.',
   'External links', 'Links to Instagram, Google Maps and Google Photos are plain links. No data is transferred until you click them; the provider’s privacy policy then applies.'],
  ['Deine Rechte', 'Du hast das Recht auf Auskunft (Art. 15 DSGVO), Berichtigung (Art. 16), Löschung (Art. 17), Einschränkung der Verarbeitung (Art. 18), Datenübertragbarkeit (Art. 20) und Widerspruch gegen die Verarbeitung (Art. 21). Schreib mir dazu einfach eine E-Mail. Außerdem kannst du dich bei einer Datenschutz-Aufsichtsbehörde beschweren, z. B. bei der Berliner Beauftragten für Datenschutz und Informationsfreiheit.',
   'Your rights', 'You have the right to access (Art. 15 GDPR), rectification (Art. 16), erasure (Art. 17), restriction of processing (Art. 18), data portability (Art. 20) and to object to processing (Art. 21). Just send me an email. You can also complain to a data protection supervisory authority, e.g. the Berlin Commissioner for Data Protection and Freedom of Information.'],
];
---
<Base lang={lang} title={`${ui[lang].privacy} | Adri Brasil`}>
  <section class="legal">
    <div class="wrap">
      <h1>{de ? 'Datenschutzerklärung' : 'Privacy policy'}</h1>
      <h2>{de ? 'Verantwortlicher' : 'Controller'}</h2>
      <p>{o.name}<br />{o.street}<br />{o.city}<br />{o.country}<br />
        {de ? 'E-Mail' : 'Email'}: <a href={`mailto:${o.email}`}>{o.email}</a></p>
      {sections.map(([hDe, tDe, hEn, tEn]) => <><h2>{de ? hDe : hEn}</h2><p>{de ? tDe : tEn}</p></>)}
      <p class="note">{de ? 'Stand' : 'Last updated'}: {o.updated}</p>
      {!de && <p class="note">The German version of this page is legally binding: <a href="/de/datenschutz/">Datenschutzerklärung (Deutsch)</a>.</p>}
    </div>
  </section>
</Base>
