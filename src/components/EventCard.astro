---
import { t, img, rich } from '../lib/sanity.js';
import { ui } from '../lib/i18n.js';
const { event, lang, upcoming = true } = Astro.props;
const d = new Date(event.start);
const fmt = (o) => d.toLocaleString(lang === 'en' ? 'en-GB' : lang, { timeZone: 'Europe/Berlin', ...o });
const u = ui[lang];
---
<article class="ev" data-start={event.start} data-upcoming={upcoming}>
  {event.image && <img src={img(event.image, 600)} alt="" loading="lazy" />}
  <div class="date">{fmt({ day: '2-digit', month: 'short' })}<small>{fmt({ weekday: 'short', hour: '2-digit', minute: '2-digit' })}</small></div>
  <h3>{t(event.title, lang)}</h3>
  <p>{event.venue}</p>
  <details>
    <summary>{u.more}</summary>
    {event.address && <p>{event.address}</p>}
    {event.description && <div class="rt" set:html={rich(t(event.description, lang))} />}
    {event.mapUrl && <a href={event.mapUrl}>{u.details}</a>}
    {event.ticketUrl && <> · <a href={event.ticketUrl}>{u.tickets}</a></>}
  </details>
</article>
<style is:global>
  .events { background:var(--ink); color:var(--bg); }
  .evgrid { display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); margin-bottom:40px; }
  .ev { background:#fff; border-radius:16px; padding:20px; border-left:10px solid var(--pink); box-shadow:0 2px 0 rgba(20,25,90,.15); }
  .ev:nth-child(3n+2) { border-color:var(--leaf); } .ev:nth-child(3n) { border-color:var(--sun); }
  .ev img { width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:10px; margin-bottom:12px; }
  .date { font:800 2.6rem/1 var(--disp); }
  .date small { display:block; font:600 .9rem var(--body); color:#5a5a86; margin-top:2px; }
  .ev h3 { font-size:1.35rem; margin:12px 0 4px; }
  .ev p { margin:0; color:#3d3d70; font-size:15px; }
  .ev summary { margin-top:14px; font:600 15px var(--body); text-decoration:underline; cursor:pointer; list-style:none; }
  .ev summary::-webkit-details-marker { display:none; }
  .ev .rt { color:#3d3d70; font-size:14px; margin-top:8px; }
  .ev details p, .ev details a { font-size:14px; margin-top:8px; }
</style>
