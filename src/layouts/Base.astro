---
import { langs, ui } from '../lib/i18n.js';
const { lang, title = 'Adrí Brasil | 100% Forró', description = 'Forró nights, workshops, DJ sets and live bands. Berlin-based.' } = Astro.props;
const u = ui[lang];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {langs.map((l) => <link rel="alternate" hreflang={l} href={`/${l}/`} />)}
</head>
<body>
  <header>
    <a class="logo" href={`/${lang}/`}>Adrí Brasil</a>
    <nav>
      <a href={`/${lang}/events/`}>{u.events}</a>
      <a href={`/${lang}/#contact`}>{u.book}</a>
      {langs.map((l) => <a href={`/${l}/`} aria-current={l === lang} class="lang">{l.toUpperCase()}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer>Berlin · <a href={`/${lang}/impressum/`}>Impressum</a> · <a href={`/${lang}/datenschutz/`}>Datenschutz</a></footer>
</body>
</html>
<style is:global>
  :root { --bg:#14195A; --bg2:#1E2578; --ink:#FFF4DC; --sun:#FFC93C; --pink:#FF5C8A; }
  body { margin:0; background:var(--bg); color:var(--ink); font:17px/1.55 system-ui, sans-serif; }
  header { display:flex; justify-content:space-between; align-items:center; padding:14px 22px; }
  nav { display:flex; gap:16px; align-items:center; }
  a { color:inherit; } .logo { font-weight:800; font-size:1.3rem; text-decoration:none; }
  .lang[aria-current="true"] { color:var(--sun); font-weight:700; }
  main { max-width:1000px; margin:0 auto; padding:0 22px 60px; }
  h1 { font-size:clamp(3.5rem,14vw,9rem); color:var(--sun); line-height:1; margin:.3em 0 .1em; }
  h2 { font-size:2rem; margin:1.6em 0 .6em; }
  footer { padding:30px 22px; color:#C9C6E8; font-size:14px; }
  .btn { background:var(--sun); color:var(--bg); border:0; border-radius:999px; padding:12px 24px; font:600 16px system-ui; text-decoration:none; cursor:pointer; }
</style>
