---
import { langs, ui } from '../lib/i18n.js';
const { lang, title = 'Adri Brasil | 100% Forró', description = 'Forró nights, workshops, DJ sets and live bands. Berlin-based.' } = Astro.props;
const u = ui[lang];
const here = (l) => Astro.url.pathname.replace(/^\/[a-z]{2}\//, `/${l}/`);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {langs.map((l) => <link rel="alternate" hreflang={l} href={here(l)} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Figtree:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <div class="wrap bar">
      <a class="logo" href={`/${lang}/`}>Adri Brasil</a>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">☰</button>
      <nav id="nav">
        <a href={`/${lang}/events/`}>{u.events}</a>
        <a href={`/${lang}/#workshops`}>{u.learn}</a>
        <a href={`/${lang}/#dj`}>{u.dj}</a>
        <a href={`/${lang}/#artists`}>{u.production}</a>
        <a href={`/${lang}/#about`}>{u.about}</a>
        <div class="lang" role="group" aria-label="Language">
          {langs.map((l) => <a href={here(l)} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}
        </div>
        <a class="btn" href={`/${lang}/#contact`}>{u.book}</a>
      </nav>
    </div>
  </header>
  <main id="top"><slot /></main>
  <footer>
    <div class="wrap">
      <div><a href={`/${lang}/impressum/`}>Impressum</a><a href={`/${lang}/datenschutz/`}>{u.privacy}</a></div>
      <div>{u.foot}</div>
    </div>
  </footer>
  <script>
    const nav = document.getElementById('nav'), b = document.getElementById('burger');
    b.onclick = () => b.setAttribute('aria-expanded', nav.classList.toggle('show'));
    nav.addEventListener('click', (e) => { if (e.target.tagName === 'A') nav.classList.remove('show'); });
  </script>
</body>
</html>
<style is:global>
  :root { --bg:#14195A; --bg2:#1E2578; --ink:#FFF4DC; --mute:#C9C6E8; --sun:#FFC93C; --pink:#FF5C8A; --leaf:#2FBF71;
    --disp:'Bricolage Grotesque','Arial Black',Impact,sans-serif; --body:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;
    color-scheme:dark; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px); }
  html { scroll-behavior:smooth; scroll-padding-top:72px; }
  *, *::before, *::after { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:400 17px/1.55 var(--body); }
  a { color:inherit; }
  :focus-visible { outline:3px solid var(--sun); outline-offset:3px; }
  .wrap { max-width:1080px; margin:0 auto; padding:0 22px; }
  h1, h2, h3 { font-family:var(--disp); font-weight:800; line-height:1.02; margin:0; }
  h2 { font-size:clamp(2rem,5vw,3.2rem); margin-bottom:28px; }
  section { padding:72px 0; }
  .ph { border-radius:14px; min-height:160px; background-size:cover; background-position:center; }

  header { position:sticky; top:env(safe-area-inset-top,0px); z-index:10; background:rgba(20,25,90,.94); backdrop-filter:blur(8px); }
  .bar { display:flex; align-items:center; gap:18px; height:64px; }
  .logo { font:800 1.25rem var(--disp); text-decoration:none; margin-right:auto; }
  nav { display:flex; gap:20px; align-items:center; }
  nav a { text-decoration:none; font-weight:600; font-size:15px; }
  nav a:hover { color:var(--sun); }
  .btn { display:inline-block; border:0; border-radius:999px; background:var(--sun); color:var(--bg); font:600 16px var(--body); padding:12px 24px; text-decoration:none; cursor:pointer; }
  .btn:hover { background:#ffd966; color:var(--bg); }
  .btn.alt { background:transparent; color:var(--ink); box-shadow:inset 0 0 0 2px var(--ink); }
  nav .btn { padding:8px 18px; font-size:15px; }
  .lang { display:flex; border-radius:999px; box-shadow:inset 0 0 0 2px var(--mute); overflow:hidden; }
  .lang a { font-size:13px; padding:6px 11px; }
  .lang a[aria-current] { background:var(--ink); color:var(--bg); }
  .burger { display:none; background:none; border:0; color:var(--ink); font-size:26px; cursor:pointer; }

  .legal h1 { font-size:clamp(2.4rem,7vw,4rem); color:var(--sun); margin-bottom:12px; }
  .legal h2 { font-size:1.4rem; margin:32px 0 8px; }
  .legal p { max-width:70ch; color:var(--mute); margin:0; }
  .legal .note { margin-top:32px; font-size:14px; }
  footer { background:#0d1040; padding:34px 0 40px; color:var(--mute); font-size:14px; }
  footer .wrap { display:flex; flex-wrap:wrap; gap:12px 26px; justify-content:space-between; }
  footer a { margin-right:16px; }

  @media (max-width:760px) {
    .burger { display:block; }
    nav { display:none; position:absolute; top:64px; left:0; right:0; flex-direction:column; align-items:flex-start; padding:16px 22px 22px; background:var(--bg); gap:14px; }
    nav.show { display:flex; }
    section { padding:56px 0; }
  }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
